# Required for real analysis. Unset runs the whole pipeline with an offline
# stand-in for the model: real sources and citations, placeholder analysis text.
ANTHROPIC_API_KEY=

# SEC returns 403 on any request whose User-Agent lacks a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=autonomous-market-analyst/0.1 (you@example.com)

# Optional overrides
ANALYST_MODEL=claude-opus-5
# One directory for the run database, fetch cache and reports. Containers set
# this to their mounted volume. Unset: the repo in a checkout, else the cwd.
# ANALYST_DATA_DIR=

# --- service (analyst serve / analyst worker) -------------------------------
# Bearer token required to start or cancel work. Leave unset only while the API
# is reachable from localhost alone: every accepted request spends model credits.
ANALYST_SERVICE_API_KEY=
# Comma-separated browser origins allowed to call the API (e.g. a frontend).
ANALYST_CORS_ORIGINS=
# Serve a finished brief again instead of re-running it, for this many seconds.
ANALYST_REPORT_TTL_SECONDS=86400
# A worker's claim on a job, and how often it renews it. Keep the lease at least
# three heartbeats long.
ANALYST_JOB_LEASE_SECONDS=120
ANALYST_JOB_HEARTBEAT_SECONDS=20
ANALYST_JOB_MAX_ATTEMPTS=3
