# Required for any LLM-backed stage. Leave unset to run in --stub mode.
ANTHROPIC_API_KEY=

# SEC requires a descriptive User-Agent with contact info on every request.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=autonomous-market-analyst/0.1 (you@example.com)

# Optional overrides
ANALYST_MODEL=claude-opus-5
ANALYST_CACHE_DIR=.cache
ANALYST_RUNS_DB=runs/runs.sqlite3
